# Copy this file to .env for local use. On a host (Render, Railway...) set these as environment variables instead.

# Required: PIN for the canteen staff screen (at least 4 characters). There is no default on purpose.
STAFF_PIN=change-me-1234

# Razorpay keys: Dashboard -> Account & Settings -> API Keys. Use TEST keys first (rzp_test_...), then LIVE keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret: the secret you type when you create the webhook (see README).
RAZORPAY_WEBHOOK_SECRET=

# Extra charge for parcel orders, in rupees.
PARCEL_FEE=5

# Minutes an unpaid online order holds the stock before it is released.
PENDING_MINUTES=15

# Where the data file lives. On a host, point this at a persistent disk, e.g. /var/data/canteen.json
DATA_FILE=./data/canteen.json

# Leave unset in real use. "mock" lets you try the whole app locally WITHOUT Razorpay (fake payments).
# PAYMENT_MODE=mock
